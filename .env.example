# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
# PostgreSQL. Supabase: transaction-mode pooler on port 6543.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Optional: session-mode URL (port 5432/direct host) for the realtime LISTEN listener.
REALTIME_DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres
# DATABASE_SSL=false            # disable TLS for a plain local Postgres
# PGPOOL_MAX=8                  # shared pool size (Vercel: keep at 3)
# CORS_ORIGINS=https://app.example.com

# ── Auth ──────────────────────────────────────────────────────────────────
# JWT signing key. Derived from DATABASE_URL/SUPABASE_SERVICE_ROLE_KEY when unset;
# pin it on multi-instance hosts.
# JWT_SECRET=change-me
# JWT_TTL_SECONDS=604800        # default 7 days

# ── Storage (photo attachments) ───────────────────────────────────────────
# Without these, files fall back to server/uploads/ (dev/VPS only).
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key
# SUPABASE_STORAGE_BUCKET=field-ledger
# Signing key for short-lived attachment URLs; derived when unset.
# UPLOAD_SIGN_SECRET=change-me
# UPLOAD_SIGN_TTL=3600

# ── Day-end report email (auto-email activates once set) ──────────────────
# When a salesman ends his day the collection report (PDF + Excel) is emailed
# to OFFICE_EMAIL. Until these are set the email is skipped and the app's
# End-day Share button is the delivery path.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false             # true for port 465
# SMTP_USER=office@example.com
# SMTP_PASS=change-me
# OFFICE_EMAIL=office@example.com
# MAIL_FROM=office@example.com  # defaults to SMTP_USER
